{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-intelligence-system",
  "main": "cloud/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*"]},
  "alias": {
    "#knowledge-store": "./cloud/runtime-store.js",
    "#analysis-provider": "./cloud/providers.js",
    "#network": "./cloud/network.js"
  },
  "d1_databases": [{"binding": "DB", "database_name": "personal-intelligence-system", "database_id": "95cf0c5a-da87-41a5-a614-e983742285dc"}],
  "workflows": [{"binding": "WORK", "name": "personal-intelligence-work", "class_name": "IntelligenceWorkflow"}],
  "services": [{"binding":"TASKS","service":"personal-intelligence-system","entrypoint":"IntelligenceTasks"}],
  "triggers": {"crons": ["0 * * * *"]},
  "vars": {"CLOUD_MODE": "1", "ANALYSIS_PROVIDER": "deepseek", "DEEPSEEK_MODEL": "deepseek-flash", "ENABLE_LEGACY_DAILY": "false"},
  "observability": {"enabled": true}
}
